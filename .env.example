DB_NAME=clinica_serena
DB_USER=clinica_app
DB_PASSWORD=change-me
DB_PORT=5432
SERVER_PORT=8080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
AUTH_MAIL_FROM=no-reply@clinica-serena.test
AUTH_PUBLIC_WEB_URL=http://localhost:3000
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_RECOVERY_TTL_SECONDS=1800
AUTH_RATE_LIMIT_MAX_REQUESTS=3
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ENTRIES=10000

# Recordatorios push (Fase D). NONE = apagado (por defecto); SIMULATED solo con dev/test; FIREBASE = FCM.
# Mantener la tarea apagada hasta validar el cliente Android de extremo a extremo.
# Para Firebase, configurar GOOGLE_APPLICATION_CREDENTIALS con la ruta a un JSON de cuenta de servicio
# montado como secreto (no guardar ni copiar ese archivo al repositorio).
CLINICA_PUSH_PROVIDER=NONE
CLINICA_PUSH_REMINDERS_ENABLED=false
CLINICA_PUSH_REMINDERS_INTERVAL_MS=300000
CLINICA_PUSH_REMINDERS_GRACE=PT2H
CLINICA_PUSH_REMINDERS_STALE_AFTER=PT10M
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
